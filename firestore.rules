rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidUserSettings(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             (data.dailyBudget is float || data.dailyBudget is int) &&
             data.dailyBudget >= 0 &&
             data.dailyBudget <= 10000000 &&
             data.currencySymbol is string &&
             data.currencySymbol.size() >= 1 &&
             data.currencySymbol.size() <= 5 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidExpense(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 80 &&
             (data.amount is float || data.amount is int) &&
             data.amount > 0 &&
             data.amount <= 10000000 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 40 &&
             data.category.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.dateKey is string &&
             data.dateKey.size() == 10 &&
             data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.monthKey is string &&
             data.monthKey.size() == 7 &&
             data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             (!('note' in data) || (data.note is string && data.note.size() <= 160)) &&
             (!('paymentMethod' in data) || data.paymentMethod in ['CASH', 'CREDIT_CARD']) &&
             (!('cardName' in data) || (data.cardName is string && data.cardName.size() <= 40)) &&
             (!('installments' in data) || (data.installments is int && data.installments >= 1 && data.installments <= 60)) &&
             (!('creditSettled' in data) || data.creditSettled is bool) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().keys().hasAll(['userId', 'dailyBudget', 'currencySymbol', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'dailyBudget', 'currencySymbol', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['dailyBudget', 'currencySymbol', 'updatedAt']);

      allow delete: if isSignedIn() && isOwner(userId) && isValidId(userId);

      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(expenseId);
        allow list: if isSignedIn() && isOwner(userId) && isValidId(userId);

        allow create: if isSignedIn() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(expenseId) &&
                         isValidExpense(incoming(), userId) &&
                         incoming().keys().hasAll(['userId', 'title', 'amount', 'category', 'dateKey', 'monthKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'amount', 'category', 'dateKey', 'monthKey', 'note', 'paymentMethod', 'cardName', 'installments', 'creditSettled', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(expenseId) &&
                         isValidExpense(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'category', 'dateKey', 'monthKey', 'note', 'paymentMethod', 'cardName', 'installments', 'creditSettled', 'updatedAt']);

        allow delete: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(expenseId);
      }
    }
  }
}
